# Example environment file. Copy to ".env" (gitignored) and fill in your paths.
# Loaded by the launch scripts (scripts/_env.sh) and by src/train.py; Hydra
# configs read these via ${oc.env:VAR_NAME}. Write absolute paths in full.

# Logs, Hydra run directories, checkpoints and evaluation samples.
SCRATCH_DIR="/path/to/scratch"

# Datasets, encoded latents and pretrained checkpoints.
DATA_DIR="/path/to/data"

# ImageNet-256 assets (defaults are relative to DATA_DIR; override as needed).
# LATENT_OUTPUT_DIR="/path/to/data/imagenet256-sd-vae-ft-mse"
# DMF_CHECKPOINT_PATH="/path/to/data/checkpoints/dmf_xl_2_256.pt"
# SIT_CHECKPOINT_PATH="/path/to/data/checkpoints/sit_xl_2_repa_256.pt"
# FID_REF_STATS="/path/to/data/checkpoints/imgnet256_torchmetrics.pt"
# DINO_REF_STATS="/path/to/data/eval_refs/imgnet256_dinov2_vitl14.pt"

# Logging backend for the launch scripts: wandb (default) or csv.
# LOGGER="csv"
# WANDB_PROJECT="stochastic-flow-maps"

# Optional tokens.
# WANDB_API_KEY=""
# HF_TOKEN=""
